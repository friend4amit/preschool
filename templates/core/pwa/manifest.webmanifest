{% load static %}{
  "name": "Aaroham",
  "short_name": "Aaroham",
  "description": "Your child's day at Aaroham — photographs, notes and attendance.",

  "//": "start_url is the PORTAL, not the marketing site. The home-screen icon belongs to a parent who is signed in; landing them on the enquiry page would be a stranger's answer to a family's tap. scope matches, so a link out to /about/ opens the browser rather than staying inside the app frame.",
  "start_url": "/portal/",
  "scope": "/portal/",
  "id": "/portal/",

  "display": "standalone",
  "orientation": "portrait",

  "//theme": "The status bar. leaf-deep is the same value the footer resolves to, so the chrome above the page is not a colour that appears nowhere else in it.",
  "theme_color": "#3a5427",
  "background_color": "#fbf7f1",

  "lang": "en-IN",
  "dir": "ltr",

  "icons": [
    {
      "src": "{% static 'img/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "//": "Android crops to whatever shape the launcher uses. Without a maskable icon it crops the 'any' one and takes the leaves off.",
      "src": "{% static 'img/icon-maskable-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'img/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Photos",
      "url": "/portal/photos/",
      "icons": [{ "src": "{% static 'img/icon-192.png' %}", "sizes": "192x192" }]
    }
  ]
}
