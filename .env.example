# Copy to .env and fill in. .env is gitignored and lives on the server only —
# generate every secret fresh, never reuse one from elsewhere.

# --- Django -------------------------------------------------------------------
# config.settings.dev locally, config.settings.prod on the server.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-fresh-random-string
# Comma-separated. Localhost for dev; the real domain in prod.
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Database -----------------------------------------------------------------
# Read by Django (django-environ). Host is the compose service name `postgres`;
# use localhost:5432 if you run manage.py on the host instead of in the container.
DATABASE_URL=postgres://aaroham:replace-me-with-a-strong-password@postgres:5432/aaroham
# Read by the postgres container itself. These MUST agree with DATABASE_URL
# above — compose cannot parse the URL to configure the database.
POSTGRES_DB=aaroham
POSTGRES_USER=aaroham
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# --- Errors -------------------------------------------------------------------
# Leave empty in dev to disable Sentry. Session Replay stays off — see plan.md.
SENTRY_DSN=

# --- Media: Cloudflare R2 -----------------------------------------------------
# Dev uses local disk; these only matter in prod.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aaroham-media
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- Media: a SECOND, PUBLIC bucket for the marketing site ---------------------
# The bucket above is PRIVATE and holds children's photos, served by short-lived
# presigned URLs after a consent check. Marketing images need the opposite:
# world-readable, cached forever, indexable by search engines. Different
# requirements, different bucket — a shared bucket with two prefixes is one typo
# away from publishing a classroom photo.
#
# Turn on public access for this bucket in Cloudflare and bind a custom domain
# (or use the pub-<id>.r2.dev subdomain it gives you).
R2_PUBLIC_BUCKET=aaroham-public
# Host ONLY — no https://, no trailing slash. This one is load-bearing: without it
# django-storages builds an unsigned URL against the S3 API endpoint, which R2 does
# not serve anonymously, and every marketing image 403s.
R2_PUBLIC_BASE_URL=

# --- Forms: Cloudflare Turnstile ----------------------------------------------
# Cloudflare publishes always-passing test keys; use those in dev.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- AI -----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Caddy (prod only) --------------------------------------------------------
# The domain Caddy issues a certificate for.
CADDY_DOMAIN=aaroham.example
# Address Let's Encrypt uses for expiry notices.
CADDY_EMAIL=ops@aaroham.example

# --- Backups ------------------------------------------------------------------
# The nightly pg_dump lands in the same R2 bucket as media, under this prefix.
# Retention is in days; older dumps are pruned by the same task that writes them.
BACKUP_PREFIX=backups/postgres/
BACKUP_RETENTION_DAYS=30
